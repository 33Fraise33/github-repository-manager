# Copy to .env.op, set OP_VAULT in your shell, and keep the copy untracked.
# The R2 Tofu State item must expose fields titled "access key id" and
# "secret access key".
AWS_ACCESS_KEY_ID="op://${OP_VAULT}/R2 Tofu State/access key id"
AWS_SECRET_ACCESS_KEY="op://${OP_VAULT}/R2 Tofu State/secret access key"
